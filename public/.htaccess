# SPA fallback for Apache / cPanel
# Toate request-urile care nu corespund unui fișier real vor servi index.html
# (necesar pentru TanStack Router să gestioneze rutele client-side).

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Nu rescrie fișiere/directoare existente (assets, imagini etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Tot restul -> index.html (SPA)
  RewriteRule ^ index.html [L]
</IfModule>

# Cache pentru assets cu hash în nume (build output Vite)
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|ttf|otf|svg|png|jpg|jpeg|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# Compresie
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
